USE attendance_management;

CREATE TABLE IF NOT EXISTS courses (
    course_id INT AUTO_INCREMENT PRIMARY KEY,
    course_code VARCHAR(20) NOT NULL,
    course_name VARCHAR(255) NOT NULL,
    credits VARCHAR(10) NOT NULL,
    semester_id INT NOT NULL
);
INSERT INTO students (name, roll_no, year, batch, email, dob, aadhar, parent_phone, address)
SELECT 
CONCAT('Student ', n) AS name,
CONCAT('24-AG-', LPAD(n,3,'0')) AS roll_no,
CASE 
WHEN n <= 40 THEN 'I Year'
WHEN n <= 80 THEN 'II Year'
WHEN n <= 120 THEN 'III Year'
ELSE 'IV Year'
END AS year,
'2024-2028',
CONCAT('student',n,'@agripro.edu'),
